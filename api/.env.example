# Database
MONGODB_URI=mongodb://localhost:27017/quiero-menu

# JWT
JWT_SECRET=dev-secret-do-not-use-in-prod
JWT_EXPIRES_IN=3d
JWT_REFRESH_SECRET=dev-refresh-secret-do-not-use-in-prod
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Custom domain (storefront en dominio propio de usuarios Pro)
# INTERNAL_API_TOKEN: token que usa el worker del host para provisionar TLS/vhost
# OWN_DOMAINS: dominios propios que no se permiten como custom domain
INTERNAL_API_TOKEN=
OWN_DOMAINS=quiero.menu,www.quiero.menu

# Logging (error | warn | info | debug | verbose; JSON lines en production)
LOG_LEVEL=info

# Sentry (error tracking; empty = disabled)
SENTRY_DSN=

# OpenAI (menu AI builder)
OPENAI_API_KEY=sk-proj-...

# Lemon Squeezy (billing, legacy)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_PRO=

# Mercado Pago (billing ARS - Argentina)
MERCADO_PAGO_ACCESS_TOKEN=TEST-...
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_AMOUNT=15000
MERCADO_PAGO_CURRENCY=ARS
MERCADO_PAGO_TRIAL_DAYS=30
